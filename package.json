{
  "name": "saulera-dossier-engine",
  "private": true,
  "type": "module",
  "description": "Generated, evidence-anchored candidate submission packs for small recruitment agencies",
  "scripts": {
    "test": "node --test test/*.test.js",
    "spike": "node spike/local.js",
    "spike:tamper": "node spike/local.js --tamper",
    "dev": "python3 scripts/dev.py",
    "db:local": "python3 scripts/dev.py --migrate-only",
    "db:preview": "python3 scripts/dev.py --migrate-remote preview",
    "db:remote": "python3 scripts/dev.py --migrate-remote production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0"
  }
}
